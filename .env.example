# Copy to .env locally. Never commit .env; obtain your own credentials.
# Structured input, demo products and local SMTP need no external API keys.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional LangSmith tracing; keep payloads hidden to protect user content.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=techstock-ai
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Relative paths assume commands run from the repository root.
DATABASE_URL=sqlite:///./data/techstock.db
API_BASE_URL=http://localhost:8000

# Safe default: local capture only. Launcher enforces 127.0.0.1:1025.
EMAIL_MODE=sandbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@techstock.test
SMTP_ALLOWED_RECIPIENTS=
# Optional real Gmail delivery (orders remain simulated): set EMAIL_MODE=real,
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASSWORD=your own Google app password, SMTP_FROM=your sender address,
# SMTP_ALLOWED_RECIPIENTS=comma-separated addresses you authorize.
# Real mode uses STARTTLS/login and does NOT start the local capture server.
# Keep real mode disabled for demo/testing unless you intend external delivery.

MAX_AGENT_STEPS=12
MAX_TOOL_RETRIES=2
OFFER_MAX_AGE_HOURS=48
# Shopping chat searches SQLite immediately. Refresh runs in the API background on startup
# when due and then every 24 hours while the backend is running.
SHOPPING_LIVE_DISCOVERY=true
# Use the deterministic planner for explicitly recognized shopping requests.
SHOPPING_LOCAL_PLANNER=true
SHOPPING_MODEL_TIMEOUT_SECONDS=25
CATALOG_AUTO_REFRESH=true
CATALOG_REFRESH_HOURS=24
CATALOG_MAX_AGE_HOURS=48
# Source-specific minimum delays still apply (Spacenet: at least 10 seconds).
SCRAPING_REQUEST_DELAY=2
SCRAPING_VALIDATED_ROUTES=true
SCRAPING_MAX_PAGES=20
SPACENET_GAMING_LISTING_LIMIT=96
# Optional browser fallback for JS-only product pages; install Chromium with: python -m playwright install chromium
SCRAPING_RENDER_JS=false

# Optional verified model prices. Leave these lines commented, not empty assignments.
# INPUT_COST_PER_MILLION=0.0
# OUTPUT_COST_PER_MILLION=0.0
# Test-only opt-in for paid live extraction; normally leave disabled.
# RUN_LIVE_OPENAI=1

# A matching observation within this window can satisfy an ordinary search immediately.
SHOPPING_FRESH_HOURS=6
